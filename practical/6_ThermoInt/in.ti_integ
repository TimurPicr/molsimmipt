# 3d Lennard-Jones melt
variable        d index 0.86
variable        sample_interval index 50
variable        sample_count index 10
variable        nsteps_lambda index 64
variable        gauss_prefactor index -20
variable        gauss_sigma index 0.1

variable        H_g equal ${gauss_prefactor}*${gauss_sigma}*sqrt(2*PI)
variable        length_each_lambda equal ${sample_interval}*${sample_count}
variable        step_number loop ${nsteps_lambda}
variable        lambda_step equal 1.0/${nsteps_lambda}
variable        int_trap equal 0
variable        int_simps equal 0

shell           rm ti_integ.log

units		lj
atom_style	atomic

lattice		fcc $d
region		box block 0 7 0 7 0 7
create_box	2 box
create_atoms	2 box
lattice		fcc $d origin 0.00001 0.00001 0.00001
create_atoms    1 box
mass		1 1.0
mass            2 1.0

group           work type 1

velocity	work create 1.0 87287 mom yes

pair_style	hybrid lj/cut 5.0 gauss/cut 1.0
pair_coeff      1 1 lj/cut 0 0 5.0
pair_coeff      2 2 gauss/cut 0 0 0.01 1.0
pair_coeff      1 2 gauss/cut ${H_g} 0.0 ${gauss_sigma} 1.0

neighbor	0.3 bin
neigh_modify	every 10 delay 0 check yes exclude type 2 2

compute         lj_temp work temp
fix		1 work langevin 0.779 0.779 0.5 78278 zero yes
fix             2 work nve

timestep	0.002

thermo_style    custom step time c_lj_temp ke pe etotal press vol enthalpy

thermo		50
run		10000

include         in.ti_integ.fwd

print           "dF with trapezoid rule: ${int_trap}" append ti_integ.log
print           "dF with parabolic rule: ${int_simps}" append ti_integ.log

pair_coeff      1 1 lj/cut 1.0 1.0 5.0
pair_coeff      2 2 gauss/cut 0 0 0.01 1.0
pair_coeff      1 2 gauss/cut 0.0 0.0 ${gauss_sigma} 1.0

unfix           1
fix		1 work langevin 0.779 0.779 0.5 78278 zero yes

thermo_style    custom step time c_lj_temp ke pe etotal press vol enthalpy

run             10000

write_dump      work atom intermed.dump

variable        int_trap_back equal 0
variable        int_simps_back equal 0

include         in.ti_integ.back

print           "dF with trapezoid rule: ${int_trap_back}" append ti_integ.log
print           "dF with parabolic rule: ${int_simps_back}" append ti_integ.log

variable        int_trap_ave equal (${int_trap}+${int_trap_back})/2.0
variable        int_simps_ave equal (${int_simps}+${int_simps_back})/2.0

print           "average dF (trapezoid): ${int_trap_ave}" append ti_integ.log
print           "average dF (parabolic): ${int_simps_ave}" append ti_integ.log

write_dump      work atom final.dump