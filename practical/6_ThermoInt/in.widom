# 3d Lennard-Jones melt
variable        d index 0.7
variable        temperature index 2.0

log             fluid_widom.log
units		lj
atom_style	atomic

lattice		sc $d origin 0.5 0.5 0.5
region		box block 0 10 0 10 0 10
create_box	1 box
create_atoms    1 box
mass		1 1.0

group           work type 1

velocity	work create 1.0 87287 mom yes

pair_style      lj/smooth 3.0 4.0

neighbor	0.3 bin
neigh_modify	every 5 delay 0 check yes

log             widom_prepare.log
pair_coeff      1 1 1.0 1.0

fix             1 work langevin ${temperature} ${temperature} 0.5 78278 zero yes
fix             2 work nve

timestep        0.002

thermo_style    custom step time temp ke pe etotal press vol enthalpy

thermo		50
run		10000

fix             tpi all widom 10 1000 1 94329 ${temperature}
log             fluid_widom_main.log

thermo_style    custom step time temp ke pe etotal press vol f_tpi[1]
run             500000