variable        kspc_tol index 1e-5
log             log.NaCl.pppm.${kspc_tol}
units		real
atom_style	charge

kspace_style    pppm ${kspc_tol}

pair_style	lj/cut/coul/long 15.0 10.0

include         lattice.conf

pair_modify     mix geometric shift yes table 16

velocity        all create 600.0 73413
fix		1 all nve

thermo		50
thermo_style    custom step temp ke pe etotal ecoul elong press
run		0

variable	E0 equal ecoul+elong
variable	E0 equal ${E0}

run		200

variable	E1 equal ecoul+elong
variable	E1 equal ${E1}

variable	dE equal ${E1}-${E0}
print "Energy difference (final - initial) with PPPM calculation: ${dE}"
write_restart	final_state.pppm.restart
