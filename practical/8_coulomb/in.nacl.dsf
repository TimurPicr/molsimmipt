variable        kappa index 0.15

log             log.NaCl.coul_dsf.kappa.${kappa}
units		real
atom_style	charge

pair_style	lj/cut/coul/dsf ${kappa} 15.0
include         lattice.conf
pair_modify     mix geometric shift yes

neighbor	1.5 bin
neigh_modify	every 20 delay 0

fix		1 all nve

thermo_style    custom step temp ke pe etotal ecoul press
thermo		50

run		0

variable	E0 equal ecoul
variable	E0 equal ${E0}

clear

read_restart    final_state.pppm.restart

pair_style	lj/cut/coul/dsf ${kappa} 15.0
pair_coeff	1 1 0.03463 2.52 15.0
pair_coeff	2 2 0.38218 3.85 15.0
pair_modify     mix geometric shift yes

fix		1 all nve

thermo_style    custom step temp ke pe etotal ecoul press
run		0

variable	E1 equal ecoul
variable	E1 equal ${E1}

variable	dE equal ${E1}-${E0}
print "Energy difference (final - initial) with DSF Coulomb screening: ${dE}"
