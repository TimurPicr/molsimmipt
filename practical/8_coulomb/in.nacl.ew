variable        kspc_tol index 1e-5
log             log.NaCl.ewald.${kspc_tol}
units		real
atom_style	charge

kspace_style    ewald ${kspc_tol}

pair_style	lj/cut/coul/long 15.0 10.0

include         lattice.conf

pair_modify     mix geometric table 16

fix		1 all nve

thermo		50
thermo_style    custom step temp ke pe etotal ecoul elong press
run		0

variable	E0 equal ecoul+elong
variable	E0 equal ${E0}

clear
kspace_style    ewald ${kspc_tol}

read_restart    final_state.pppm.restart

pair_style	lj/cut/coul/long 15.0 10.0
pair_coeff	1 1 0.03463 2.52 15.0
pair_coeff	2 2 0.38218 3.85 15.0
pair_modify     mix geometric shift yes table 16

fix		1 all nve

thermo_style    custom step temp ke pe etotal ecoul elong press

run		0

variable	E1 equal ecoul+elong
variable	E1 equal ${E1}

variable	dE equal ${E1}-${E0}
print "Energy difference (final - perfect lattice) with Ewald summation: ${dE}"
