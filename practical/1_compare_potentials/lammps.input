variable	ptype index eam
variable	morse_rcut index 4.95
if "${ptype} == eam" then "jump SELF EAM"
if "${ptype} == morse" then "jump SELF MORSE" else "jump SELF UNKNOWN"

label		EAM
variable	pinclude string potentials/EAM.potential
log		log.eam.4.95
jump SELF MAIN

label		MORSE
variable	pinclude string potentials/MORSE.potential
log		log.morse_pair.${morse_rcut}
jump SELF MAIN

label		MAIN
units		metal
atom_style	atomic
boundary	p p p 

lattice		fcc 3.2 origin 0.5 0.5 0.5
region		box block 0 10.0 0 10.0 0 10.0
create_box	1 box
create_atoms	1 box
mass		1 63.546

include		${pinclude}
pair_modify tail yes
neighbor	1.0 bin
neigh_modify	every 2 delay 0 check no

variable energy_peratom equal "pe / atoms"
variable atomic_volume equal "vol / atoms"

thermo_style custom step temp press vol v_atomic_volume density pe v_energy_peratom

velocity all create 300.0 42 mom yes rot yes dist gaussian

fix 1 all npt temp 300.0 300.0 0.1 iso 1.0 1.0 1.0

thermo 1
run 10000
quit

label		UNKNOWN
print "Unknown potential type"
