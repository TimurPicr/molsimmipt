variable	ptype index eam
variable	morse_rcut index 4.95
if "${ptype} == eam" then "jump SELF EAM"
if "${ptype} == morse" then "jump SELF MORSE" else "jump SELF UNKNOWN"

label		EAM
variable	pinclude string potentials/EAM.potential
log		log.eam.4.95
jump SELF MAIN

label		MORSE
variable	pinclude string potentials/MORSE.potential
log		log.morse.${morse_rcut}
jump SELF MAIN

label		MAIN
units		metal
atom_style	atomic
boundary	p p p 

lattice		fcc 3.2 origin 0.5 0.5 0.5
region		box block 0 10 0 10 0 10
create_box	1 box
create_atoms	1 box
mass		1 63.550

include		${pinclude}
neighbor	1.0 bin
neigh_modify	every 2 delay 0 check no

variable	energy_peratom equal "pe / atoms"
variable	atomic_volume equal "vol /atoms"
thermo_style custom step vol v_atomic_volume density pe v_energy_peratom press

fix		1 all nve

fix		2 all deform 1 x final 0 50.0 y final 0 50.0 z final 0 50.0 remap x units box
thermo		1
run		250
quit

label		UNKNOWN
print "Unknown potential type"
