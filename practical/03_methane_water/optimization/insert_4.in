include in.common
unfix myshk
set group CH4 x 3.8521946770994067 y 7.005347896586374 z 9.305872129709094
pair_coeff 1 3 lj/cut/soft 0.23334707626194934 3.44445 0.0
run 0
variable zero equal $(pe:%.16g)
pair_coeff 1 3 lj/cut/soft 0.23334707626194934 3.44445 1.0
run 0
print "$(pe-v_zero:%.16g)" file optimization/insert_4.energy screen no
