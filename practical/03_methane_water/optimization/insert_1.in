include in.common
unfix myshk
set group CH4 x 8.839579644419228 y 1.7362707095312964 z 14.057576598176695
pair_coeff 1 3 lj/cut/soft 0.23334707626194934 3.44445 0.0
run 0
variable zero equal $(pe:%.16g)
