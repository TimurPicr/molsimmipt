variable	T equal 300
variable	P index 1.0


units real
atom_style full
bond_style harmonic
angle_style charmm
#специальный pair_style для воды
pair_style lj/cut/tip4p/long/soft 1 2 1 1 0.1546 2.0 0.5 14.0 14.0
#метод и точность расчета кулоновских взаимодействий
kspace_style pppm/tip4p 1.0e-4

#создание ячейки
lattice		sc 5.0
region box block 0 6 0 6 0 6
create_box 3 box bond/types 1 angle/types 1 extra/bond/per/atom 2 &
extra/angle/per/atom 2 extra/special/per/atom 2

#подключаем файл с параметрами потенциала
include		water_2005.ff

#параметры молекулы
molecule	h2o water_2005.txt
create_atoms	0 region box mol h2o 454756

group		H2O type 1 2
#delete_atoms	overlap 2 H2O H2O mol yes

#вставка псевдоатома метана
create_atoms	3 random 1 340509 box

#модель воды жесткая, fix shake фиксирует связи и углы
fix		myshk H2O shake 1.0e-5 200 0 b 1 a 1 mol h2o

fix		integ all nvt temp 300 300 100

thermo		1000
thermo_style	custom step temp press pe ke etotal ecoul epair ebond eangle density lx

neighbor	1.0 bin
neigh_modify	delay 0 every 1 check yes one 10000 page 100000

#аналог minimize
timestep	0.001
run		10000
write_data	H2O.data

#достижение заданных условий
unfix		integ
fix             integ all npt temp ${T} ${T} 100 iso ${P} ${P} 1000

#вычисление среднего размера ячейки
variable        Lx equal lx
variable        Ly equal ly
variable        Lz equal lz
fix		sizes all ave/time 10 40 4000 v_Lx v_Ly v_Lz ave one file sizes.out

timestep	1.0
run		100000

write_data	h20_npt.data

#изменение размера ячейки, чтобы он соответствовал среднему
variable	Lx_fin equal f_sizes[1]
variable	Ly_fin equal f_sizes[2]
variable	Lz_fin equal f_sizes[3]
change_box	all x final 0 ${Lx_fin} y final 0 ${Ly_fin} z final 0 ${Lz_fin} remap units box
unfix		integ

#непосредственно получение равновесной конфигурации
fix             integ all nvt temp ${T} ${T} 100 
run		100000

write_data	h2o_equil.data
