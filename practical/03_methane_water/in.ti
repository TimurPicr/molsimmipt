include in.common
pair_coeff 1 3 lj/cut/soft ${eps} 3.44445 ${lam}
pair_coeff 2 3 lj/cut/soft 0.0 3.44445 ${lam}
fix integ all nvt temp ${T} ${T} 100
run ${eq}
reset_timestep 0

dump coords sample custom ${stride} ${out}/positions.dump id type x y z
dump_modify coords sort id pbc yes format float %.12g
run ${steps}
write_data ${out}/final.data pair ij
