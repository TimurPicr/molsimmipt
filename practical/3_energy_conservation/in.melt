# 3d Lennard-Jones melt

variable	length index 2000 4000 5000 10000 20000 40000

units		lj
atom_style	atomic

lattice		sc 0.8442
region		box block 0 10 0 10 0 10
create_box	1 box
create_atoms	1 box
mass		1 1.0

velocity	all create 3.0 87287

pair_style	lj/smooth 2.5 3.0
pair_coeff	1 1 1.0 1.0

neighbor	0.3 bin
neigh_modify	every 20 delay 0 check no

fix		1 all nve

thermo_style	custom step time temp ke pe etotal press lx

thermo		50
run		10000

write_restart	melt.restart

label	loop_start

clear

read_restart melt.restart

log		log.melt.${length}.txt

variable	tstep equal 20/${length}

pair_style	lj/smooth 2.5 3.0
pair_coeff	1 1 1.0 1.0

neighbor	0.3 bin
neigh_modify	every 20 delay 0 check no

fix		1 all nve

reset_timestep	0
variable	e0 equal etotal
run		0
variable	ediff equal etotal-${e0}

thermo_style	custom step time temp ke pe v_ediff press

thermo		50

timestep	${tstep}

run		${length}

next length

if "${length} < 50000" then "jump SELF loop_start"
