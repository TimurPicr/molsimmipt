# methane simulation

log             log.twophase.txt

units		real
atom_style	atomic

lattice		sc 4.21
region		box block 0 50 0 10 0 10
region		liq block 17.5 32.5 0 10 0 10
region		gas block 16 34 0 10 0 10 side out
create_box	1 box
create_atoms	1 region liq
create_atoms	1 random 490 54321 gas
mass		1 16.0426

velocity	all create 300.0 87287

pair_style	lj/smooth 12.0 14.0
pair_coeff	1 1 0.29410 3.73

neighbor	0.3 bin
neigh_modify	every 20 delay 0 check no

fix		1 all nve/limit 1.0
fix		2 all temp/berendsen 150.0 150.0 20.0
fix		3 all momentum 1 linear 1 1 1 angular

dump		snap all custom 5000 2phase.*.dump id xs ys zs

thermo_style    custom step temp ke pe etotal pxx
thermo		250

timestep        2
run		5000

unfix	1

fix             1 all nve
run             25000

unfix	1
unfix	2

reset_timestep 0
fix	       1 all nvt temp 150.0 150.0 300.0
compute        profile all chunk/atom bin/1d x lower 0.02 units reduced
fix            ave_density all ave/chunk 200 500 100000 profile density/mass file ch4.150K.density.txt

run	100000
