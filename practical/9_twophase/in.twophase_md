# methane simulation
variable        temp index 150

log             log.twophase.txt

units		real
atom_style	atomic

lattice		sc 4.21 origin 0.5 0.5 0.5
region		box block -25 25 -5 5 -5 5
region		liq block -8 8 -5 5 -5 5
region		gas block -8 8 -5 5 -5 5 side out
create_box	1 box
create_atoms	1 region liq
create_atoms	1 region gas subset 490 54321
mass		1 16.0426

velocity	all create 300.0 87287

pair_style	lj/smooth 12.0 14.0
pair_coeff	1 1 0.29410 3.73

neighbor	0.3 bin
neigh_modify	every 20 delay 0 check no

fix		1 all nve/limit 1.0
fix		2 all temp/berendsen $(v_temp) $(v_temp) 20.0
fix		3 all momentum 1 linear 1 1 1 angular

dump		snap all custom 5000 2phase.*.dump id xs ys zs

thermo_style    custom step temp ke pe etotal pxx pyy pzz
thermo		250

timestep        2
run		5000

unfix	1

fix             1 all nve
run             100000

unfix	1
unfix	2

reset_timestep 0
fix	       1 all nvt temp $(v_temp) $(v_temp) 300.0
compute        stress all stress/atom NULL
compute        profile all chunk/atom bin/1d x lower $(lx/100) units box
fix            ave_density all ave/chunk 200 1250 250000 profile density/mass c_stress[1] c_stress[2] c_stress[3] file log.ch4.$(v_temp)K.density_stress.txt

run	300000
